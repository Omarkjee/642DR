# Simulator and training settings. These are starting assumptions, not measured
# properties of a particular home or experimentally selected hyperparameters.
THERMOSTAT_SEED=42
THERMOSTAT_EPISODES=500
THERMOSTAT_STEPS_PER_EPISODE=168
# Fixed at 1 hour because occupancy and tariff schedules are hourly.
THERMOSTAT_TIME_STEP_HOURS=1.0

# Single-zone RC model: resistance (deg F/kW), capacitance (kWh/deg F), and
# heating/cooling powers (kW). Cooling is applied as negative thermal power.
THERMOSTAT_THERMAL_RESISTANCE_F_PER_KW=2.0
THERMOSTAT_THERMAL_CAPACITANCE_KWH_PER_F=5.0
THERMOSTAT_HEATING_LOW_KW=3.0
THERMOSTAT_HEATING_HIGH_KW=6.0
THERMOSTAT_COOLING_LOW_KW=3.0
THERMOSTAT_COOLING_HIGH_KW=6.0
THERMOSTAT_INITIAL_TEMPERATURE_MEAN_F=72.0
THERMOSTAT_INITIAL_TEMPERATURE_STD_F=1.0
THERMOSTAT_TEMPERATURE_NOISE_STD_F=0.05

# Deterministic daily weather and weekday occupancy/peak-price schedules.
THERMOSTAT_OUTDOOR_TEMPERATURE_MEAN_F=50.0
THERMOSTAT_OUTDOOR_TEMPERATURE_AMPLITUDE_F=12.0
THERMOSTAT_OUTDOOR_TEMPERATURE_PEAK_HOUR=15
THERMOSTAT_WEEKDAY_AWAY_START_HOUR=8
THERMOSTAT_WEEKDAY_AWAY_END_HOUR=18
THERMOSTAT_PEAK_PRICE_START_HOUR=16
THERMOSTAT_PEAK_PRICE_END_HOUR=21
THERMOSTAT_OFF_PEAK_PRICE_USD_PER_KWH=0.12
THERMOSTAT_PEAK_PRICE_USD_PER_KWH=0.36
THERMOSTAT_COMFORT_LOW_F=68.0
THERMOSTAT_COMFORT_HIGH_F=76.0

# Q-table bins; values outside each interval use a saturated edge bin.
THERMOSTAT_INDOOR_TEMPERATURE_BIN_WIDTH_F=2.0
THERMOSTAT_INDOOR_TEMPERATURE_BIN_MIN_F=40.0
THERMOSTAT_INDOOR_TEMPERATURE_BIN_MAX_F=92.0
THERMOSTAT_OUTDOOR_TEMPERATURE_BIN_WIDTH_F=5.0
THERMOSTAT_OUTDOOR_TEMPERATURE_BIN_MIN_F=-20.0
THERMOSTAT_OUTDOOR_TEMPERATURE_BIN_MAX_F=80.0

# Q-learning hyperparameters.
THERMOSTAT_LEARNING_RATE=0.1
THERMOSTAT_DISCOUNT_FACTOR=0.99
THERMOSTAT_EPSILON_START=1.0
THERMOSTAT_EPSILON_MIN=0.05
THERMOSTAT_EPSILON_DECAY=0.995

# Reward weights. These are initial values, not final experimental conclusions.
THERMOSTAT_COST_WEIGHT=1.0
THERMOSTAT_COMFORT_WEIGHT=5.0
THERMOSTAT_SWITCH_WEIGHT=0.1
