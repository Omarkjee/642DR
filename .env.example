# Reproducible starting settings; tune and justify values through experiments.
THERMOSTAT_SEED=42
THERMOSTAT_EPISODES=500
THERMOSTAT_STEPS_PER_EPISODE=168

# Q-learning hyperparameters.
THERMOSTAT_LEARNING_RATE=0.1
THERMOSTAT_DISCOUNT_FACTOR=0.99
THERMOSTAT_EPSILON_START=1.0
THERMOSTAT_EPSILON_MIN=0.05
THERMOSTAT_EPSILON_DECAY=0.995

# Reward weights. These are initial values, not final experimental conclusions.
THERMOSTAT_COST_WEIGHT=1.0
THERMOSTAT_COMFORT_WEIGHT=5.0
THERMOSTAT_SWITCH_WEIGHT=0.1
